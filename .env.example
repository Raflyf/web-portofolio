# ============================================================================
# RAFLY FIRMANSYAH PORTFOLIO - SERVER-SIDE SECRETS (TEMPLATE)
# Fill these in your Vercel Project Settings -> Environment Variables
# NEVER commit your real .env or .env.local file with production secrets!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. OmniRoute Dedicated Local/Cloudflare Gateway (Priority #1)
# ----------------------------------------------------------------------------
OMNIROUTE_URL=https://your-cloudflare-tunnel.trycloudflare.com/v1/chat/completions
OMNIROUTE_KEY=your_omniroute_api_key_here
# Leave OMNIROUTE_KEY empty (or unset) if you do not have an OmniRoute key —
# the server uses its absence to detect "no keys configured" and guides the
# terminal user to run `setkey <provider> <key>`.

# ----------------------------------------------------------------------------
# 2. OpenRouter Multi-AI Gateway Pool
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_primary_key_here
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3

# ----------------------------------------------------------------------------
# 3. OpenCode Dual-Account Pool (DeepSeek V4 & Nemotron)
# ----------------------------------------------------------------------------
OPENCODE_API_KEY=sk-your_opencode_primary_key_here
OPENCODE_API_KEYS=sk-opencode-key1,sk-opencode-key2

# ----------------------------------------------------------------------------
# 4. Standalone Flagship Providers
# ----------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your_nvidia_nim_key_here
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2
MINIMAX_API_KEY=your_minimax_api_key_here
OLLAMA_CLOUD_API_KEY=your_ollama_api_key_here

# ----------------------------------------------------------------------------
# 5. Unified AI Key List (optional: single comma/newline-separated token list)
#    The server auto-classifies each token (sk-or-v1-* → OpenRouter,
#    sk-cp-/sk-minimax-* → MiniMax, nvapi-* → NVIDIA, sk-omni-* → OmniRoute,
#    other sk- (len >= 40) → OpenCode, contains '.' / 32-char / ollama-* → Ollama).
# ----------------------------------------------------------------------------
AI_KEYS=

# ----------------------------------------------------------------------------
# 6. Supabase (Telemetry, AI Memories RAG & Admin Security Cloud Sync)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# REQUIRED for admin auth writes after the C4 security fix: the /api/admin-otp
# function authenticates to admin_auth_config with the service role key because
# the table has NO anon SELECT/INSERT/UPDATE/DELETE policies. Never expose this
# key to the client — server-side env only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----------------------------------------------------------------------------
# 7. Email Dispatch (OTP Reset Notifications) — EmailJS or Resend
# ----------------------------------------------------------------------------
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here
RESEND_API_KEY=re_your_resend_api_key_here

# ----------------------------------------------------------------------------
# 8. CORS
# ----------------------------------------------------------------------------
ALLOWED_ORIGIN=https://raflyfirmansyah-portofolio.vercel.app
