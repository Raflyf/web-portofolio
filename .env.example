# ============================================================================
# RAFLY FIRMANSYAH PORTFOLIO - SERVER-SIDE SECRETS (TEMPLATE)
# Fill these in your Vercel Project Settings -> Environment Variables
# NEVER commit your real .env.local file with production secrets!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. RUNTIME & MODEL RACING
# ----------------------------------------------------------------------------
RACE_MODELS=1
RACE_STAGGER_MS=400
CONNECT_TIMEOUT_MS=3000
CHAIN_DEADLINE_MS=45000
FIRST_TOKEN_TIMEOUT_MS=5500
STREAM_IDLE_TIMEOUT_MS=30000
VISION_FIRST_TOKEN_MS=12000
VISION_CONNECT_TIMEOUT_MS=8000
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=2500
MAX_TOKENS_LIMIT=8000
SLOW_MODEL_MS=12000

# ----------------------------------------------------------------------------
# 2. PROVIDER TIER 1: DREAMPROMPTING (GROQ/QWEN 3.6 27B & GROQ/GPT-OSS 120B)
# ----------------------------------------------------------------------------
DREAMPROMPTING_KEYS=dp-your_key_here
DAILY_CAP_DREAMPROMPTING=1000
DAILY_TOKEN_CAP_DREAMPROMPTING=500000

# ----------------------------------------------------------------------------
# 3. PROVIDER TIER 2: CLOUDFLARE WORKERS AI (QWEN 3.8 27B, NEMOTRON 3, SCOUT)
# ----------------------------------------------------------------------------
CLOUDFLARE_KEYS=accountId:token_here,anotherAccountId:anotherToken
CLOUDFLARE_ACCOUNT_ID=
DAILY_CAP_CLOUDFLARE=120
DAILY_TOKEN_CAP_CLOUDFLARE=10000

# ----------------------------------------------------------------------------
# 4. PROVIDER TIER 3: OPENCODE FREE (MUSE-SPARK 1.3 & MIMO-V2.6)
# ----------------------------------------------------------------------------
OPENCODE_KEYS=public
DAILY_CAP_OPENCODE=1000
DAILY_TOKEN_CAP_OPENCODE=0

# ----------------------------------------------------------------------------
# 5. PROVIDER TIER 4: OPENROUTER (NEMOTRON 3 ULTRA 550B & LING 3.0 FLASH)
# ----------------------------------------------------------------------------
OPENROUTER_KEYS=sk-or-v1-key1,sk-or-v1-key2
DAILY_CAP_OPENROUTER=50
DAILY_TOKEN_CAP_OPENROUTER=0

# ----------------------------------------------------------------------------
# 6. PROVIDER TIER 5: NVIDIA NIM (DIFFUSION GEMMA 26B & LLAMA 3.2 VISION)
# ----------------------------------------------------------------------------
NVIDIA_KEYS=nvapi-key1,nvapi-key2
DAILY_CAP_NVIDIA=1000
DAILY_TOKEN_CAP_NVIDIA=0

# ----------------------------------------------------------------------------
# 7. PROVIDER TIER 6: GROQ CLOUD API (QWEN 3.8 27B & GPT-OSS 120B)
# ----------------------------------------------------------------------------
GROQ_KEYS=gsk_key1,gsk_key2
DAILY_CAP_GROQ=1000
DAILY_TOKEN_CAP_GROQ=200000

# ----------------------------------------------------------------------------
# 8. PROVIDER TIER 7: GOOGLE GEMINI API (GEMINI 3.8 FLASH & GEMINI FLASH LITE)
# ----------------------------------------------------------------------------
GEMINI_KEYS=AQ.your_gemini_key_here
DAILY_CAP_GEMINI=1500
DAILY_TOKEN_CAP_GEMINI=0

# ----------------------------------------------------------------------------
# 9. PROVIDER TIER 8: DAHL GLOBAL API (DEEPSEEK V4 FLASH & GLM 5.3 FLASH)
# ----------------------------------------------------------------------------
DAHL_KEYS=dahl_key1,dahl_key2
DAHL_BASE_URL=https://inference.dahl.global/v1
DAILY_CAP_DAHL=5000
DAILY_TOKEN_CAP_DAHL=0

# ----------------------------------------------------------------------------
# 10. SUPABASE & EMAIL
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=onboarding@resend.dev
ALLOWED_ORIGIN=https://raflyfirmansyah-portofolio.vercel.app

# ----------------------------------------------------------------------------
# 11. CLIENT-SIDE (Vite)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
